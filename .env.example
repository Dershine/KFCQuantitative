# Free learning profile: BaoStock history + AKShare quotes/news. No data key is required.
KFCQUANT_DATA_PROFILE=learning
KFCQUANT_MARKET_PROVIDER=baostock
KFCQUANT_LIVE_PROVIDER=akshare
KFCQUANT_NEWS_PROVIDER=akshare

# DeepSeek structured event extraction and post-close reports.
LLM_API_KEY=
KFCQUANT_LLM_PROVIDER=deepseek
KFCQUANT_LLM_BASE_URL=https://api.deepseek.com

# Local paths
KFCQUANT_DATABASE_PATH=data/kfcquant.duckdb
KFCQUANT_RAW_DATA_DIR=data/raw
KFCQUANT_REPORT_DIR=reports
KFCQUANT_RUNTIME_DIR=runtime
KFCQUANT_BACKUP_DIR=backups

# Current DeepSeek model names; update them if the provider changes its catalog.
KFCQUANT_LLM_EXTRACT_MODEL=deepseek-v4-flash
KFCQUANT_LLM_REPORT_MODEL=deepseek-v4-pro

# Optional paid profile. Only needed when either provider is set to tushare.
TUSHARE_TOKEN=

# Paper-account assumptions; update to match the user's broker before comparison.
KFCQUANT_INITIAL_CASH=100000
KFCQUANT_COMMISSION_RATE=0.00025
KFCQUANT_MIN_COMMISSION=5
KFCQUANT_STAMP_DUTY_RATE=0.0005
KFCQUANT_SLIPPAGE_RATE=0.0005

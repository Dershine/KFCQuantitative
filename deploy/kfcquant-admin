#!/usr/bin/env bash
set -euo pipefail

if [[ $EUID -ne 0 ]]; then
  echo "Run with sudo: sudo kfcquant-admin <command>" >&2
  exit 1
fi

set -a
# shellcheck disable=SC1091
source /etc/kfcquant/research.env
if [[ -f /opt/kfcquant/current/.release.env ]]; then
  # shellcheck disable=SC1091
  source /opt/kfcquant/current/.release.env
fi
set +a

cd /opt/kfcquant/current
exec /usr/sbin/runuser -u kfcquant --preserve-environment -- /opt/kfcquant/current/.venv/bin/kfcquant "$@"

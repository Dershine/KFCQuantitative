[Unit]
Description=KFCQuant Research Scheduler and Database Writer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kfcquant
Group=kfcquant
WorkingDirectory=/opt/kfcquant/app
EnvironmentFile=/etc/kfcquant/research.env
EnvironmentFile=-/opt/kfcquant/app/.release.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/var/lib/kfcquant
ExecStart=/opt/kfcquant/app/.venv/bin/kfcquant scheduler
Restart=always
RestartSec=10
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kfcquant

[Install]
WantedBy=multi-user.target

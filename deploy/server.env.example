# Research secrets (/opt/kfcquant/research/.env)
LLM_API_KEY=
KFCQUANT_LLM_PROVIDER=deepseek
KFCQUANT_LLM_BASE_URL=https://api.deepseek.com
KFCQUANT_LLM_EXTRACT_MODEL=deepseek-v4-flash
KFCQUANT_LLM_REPORT_MODEL=deepseek-v4-pro
KFCQUANT_DATA_PROFILE=learning
KFCQUANT_MARKET_PROVIDER=baostock
KFCQUANT_LIVE_PROVIDER=akshare
KFCQUANT_NEWS_PROVIDER=akshare

# Persistent server paths. They intentionally live outside the Git checkout.
KFCQUANT_DATABASE_PATH=/var/lib/kfcquant/data/kfcquant.duckdb
KFCQUANT_RAW_DATA_DIR=/var/lib/kfcquant/data/raw
KFCQUANT_REPORT_DIR=/var/lib/kfcquant/reports
KFCQUANT_RUNTIME_DIR=/var/lib/kfcquant/runtime
KFCQUANT_BACKUP_DIR=/var/lib/kfcquant/backups

# Operations secrets (/etc/kfcquant/ops.env)
KFCOPS_GITHUB_TOKEN=
KFCOPS_SESSION_SECRET=
KFCOPS_GITHUB_REPOSITORY=Dershine/KFCQuantitative
